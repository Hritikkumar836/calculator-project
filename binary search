import java.util.*;
public class Main{
    public static void main(String java[]){
        int n = 1000000;
        int arr[]=new int[n];
        // making n size array and filling val inside.
        for(int i = 0;i<n;i++){
            arr[i] = i+2;
        }
        // checking if value is there...
        int k = -500;
        int start = 0; int end = n-1;
        while(start<=end){
           int mid = (start+end)/2;
            if(arr[mid] == k){
                System.out.println("found");
                break;
            }
            else if(arr[mid]>k) end=mid-1;
            else{
                start = mid+1;
            }
        }
    }
}
